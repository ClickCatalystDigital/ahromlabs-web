{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ahrom-labs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [{ "pattern": "ahromlabs.com", "custom_domain": true }],
  // No R2/KV/queue bindings: this app is fully static with no ISR/revalidation,
  // so OpenNext's incremental-cache subsystem is never exercised. No Images
  // binding either: next/image is set to unoptimized in next.config.ts to
  // avoid a paid Cloudflare Images dependency for a handful of small assets.
  "observability": {
    "enabled": true
  },
  // Form leads (src/lib/lead-email.ts): Cloudflare Email Sending, onboarded for notify.ahromlabs.com only
  // (records under that subdomain; the root domain's Google Workspace mail records are untouched). The binding
  // may only send from website@notify.ahromlabs.com to pujan@ahromlabs.com. Secret: DEMO_LEAD_KEY (shared with
  // the three demo Workers).
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "pujan@ahromlabs.com",
      "allowed_sender_addresses": ["website@notify.ahromlabs.com"]
    }
  ],
  // 5 form submissions per minute per key (per visitor IP for the contact form; per demo and per visitor email
  // for demo leads). Rate-limit namespace ids are per account; 1002 is unused there (the LS demo uses 1001).
  "ratelimits": [
    { "name": "FORM_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": { "LEADS_TO": "pujan@ahromlabs.com" }
}
