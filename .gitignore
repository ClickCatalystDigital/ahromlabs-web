# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.dev.vars

# cloudflare / opennext
/.open-next/
.wrangler/
cloudflare-env.d.ts

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated by scripts/build-markdown.mjs
/public/md/

.demo-secrets

# generated by scripts/build-content.mjs (git dates)
/src/lib/page-dates.generated.json

# Google credentials for scripts/google-insights.mjs belong in ~/.config/ahrom-labs/, never here.
service-account*.json
pagespeed-key
.indexnow-last
